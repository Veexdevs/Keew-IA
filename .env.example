# ─────────────────────────────────────────────────────────────────────────────
#  Keew IA — variáveis de ambiente
#  Copie para .env.local (dev) ou configure no painel da Vercel (produção).
#
#  A Keew é a única inteligência exposta: existe um só modelo público, o
#  "keew-1". Estas variáveis só dizem ao servidor qual motor de raciocínio
#  usar por baixo. Elas nunca aparecem na interface, nem nas respostas.
# ─────────────────────────────────────────────────────────────────────────────

# ── Motor de raciocínio (servidor) ───────────────────────────────────────────
# Base URL do motor. Padrão: https://api.deepseek.com/v1
KEEW_MODEL_BASE_URL=https://api.deepseek.com/v1

# Nome do modelo no motor. Padrão: deepseek-reasoner
KEEW_MODEL_NAME=deepseek-reasoner

# Chave do motor. SEM ESTA CHAVE a Keew continua online com o núcleo
# determinístico (cálculos, datas, conversões, resumos, conhecimento),
# mas não faz conversa aberta. É o único item obrigatório para a IA
# pensar sozinha 24/7.
KEEW_MODEL_API_KEY=

# ── Identidade da API própria ────────────────────────────────────────────────
# Chave que protege /api/v1/* e o workspace. Vazio = API aberta.
# Gere com: openssl rand -hex 32
KEEW_ACCESS_KEY=

# ── Memória 24/7 (Supabase/Postgres) ─────────────────────────────────────────
# Guarda conversas, base de conhecimento, automações e telemetria para que a
# Keew continue aprendendo e executando sem o navegador aberto. — opcional
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Agendador ────────────────────────────────────────────────────────────────
# Token dos jobs automáticos (/api/automations/run). Gere com: openssl rand -hex 32
KEEW_CRON_SECRET=
