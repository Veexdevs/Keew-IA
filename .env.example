# ─────────────────────────────────────────────────────────────────────────────
#  Keew IA — variáveis de ambiente
#  Copie para .env.local (dev) ou configure no painel da Vercel (produção).
# ─────────────────────────────────────────────────────────────────────────────

# Provedor principal de inferência (OpenAI-compatible).
# Funciona com DeepSeek, OpenRouter, Together, Groq, vLLM local, Ollama, etc.
KEEW_MODEL_PROVIDER=deepseek
KEEW_MODEL_BASE_URL=https://api.deepseek.com/v1
KEEW_MODEL_API_KEY=
KEEW_MODEL_NAME=deepseek-reasoner

# Chave de acesso ao workspace (se vazia, o app fica aberto).
KEEW_ACCESS_KEY=

# Supabase (memória/conhecimento da IA, histórico e usuários) — opcional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token dos jobs automáticos (cron da Vercel). Gere com: openssl rand -hex 32
KEEW_CRON_SECRET=
